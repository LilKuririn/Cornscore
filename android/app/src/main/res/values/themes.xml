<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cornscore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Exemption du bord à bord : encore honorée par Android 15, ignorée
             dès l'API 36. Conservée sans y compter — ce sont les marges
             appliquées dans MainActivity qui font le travail. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
