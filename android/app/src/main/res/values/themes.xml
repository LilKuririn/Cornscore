<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cornscore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Android 15 dessine sous les barres système par défaut dès l'API 35.
             L'application n'a rien à y gagner : on demande l'exemption.
             Attribut ignoré par les versions antérieures. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
